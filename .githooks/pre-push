#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# 拒绝直接推送主干分支。
#
# 为什么：防覆盖靠两件事 —— ① 各干各的（worktree 隔离）② 一次只落一个（单一入口）。
#         pre-commit 管①，这个钩子管②。
#         因为所有 worktree 共用同一个 .git，这一个钩子对全部 worktree 同时生效，
#         这正是本地闸门能成立、不必依赖 GitHub 分支保护的原因。
#
# 谁能推：只有合并脚本（scripts/merge_task.py），它带 HUB_ALLOW_TRUNK_PUSH=1。
#         合并脚本会先对齐主干、亲自跑一遍测试，通过了才合。
#
# 挡哪些分支 = 三者的并集：
#   ① 兜底名单 master / main / develop —— 即使配置读不到也挡得住
#   ② .agents/project.json 的 trunk
#   ③ .agents/project.json 的 protectedBranches（可选数组，给有多条主干的项目）
# 兜底名单的意义：python 不在 PATH、配置缺失、worktree 停在老分支上时，闸门仍然成立。
# 宁可多挡一条（推特性分支不受影响），也不要因为读不到配置就放空门。
#
# 推特性分支不受影响，随便推。
# ─────────────────────────────────────────────────────────────────────────────

[ "$HUB_ALLOW_TRUNK_PUSH" = "1" ] && exit 0

# ② + ③：从项目配置读。读不到就留空，只靠兜底名单。
extra=$(python -c "
import json, sys
if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.reconfigure(encoding='utf-8')   # 不加这句，配置里的中文会让本段崩掉、钩子静默走兜底
try:
    cfg = json.load(open('.agents/project.json', encoding='utf-8'))
except Exception:
    sys.exit(0)
names = [cfg.get('trunk') or '']
pb = cfg.get('protectedBranches') or []
if isinstance(pb, list):
    names += [str(x) for x in pb]
print(' '.join(sorted({n for n in names if n})))
" 2>/dev/null)

is_protected() {
  case "$1" in
    master|main|develop) return 0 ;;          # ① 兜底名单
  esac
  for p in $extra; do
    [ "$1" = "$p" ] && return 0
  done
  return 1
}

blocked=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/*) name="${remote_ref#refs/heads/}" ;;
    *) continue ;;
  esac
  if is_protected "$name"; then
    blocked="${blocked}${name} "
  fi
done

if [ -n "$blocked" ]; then
  echo "" >&2
  echo "  ✗ 不能直接推主干：$blocked" >&2
  echo "" >&2
  echo "    主干只有一个入口 —— 合并脚本。它会先对齐主干、亲自跑测试，过了才合。" >&2
  echo "    agent 自己推主干，等于绕开了唯一那道验证。" >&2
  echo "" >&2
  echo "  正确做法：把你的分支推上去，交给合并位审：" >&2
  echo "" >&2
  echo "    git push -u origin \$(git branch --show-current)" >&2
  echo "" >&2
  exit 1
fi

exit 0
